# ============================================================================
# LVL-CODES: 2026 Sales Target Management System
# Environment Configuration Template
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual values (never commit .env to version control)
# 3. Keep this .env.example updated with new variables
# ============================================================================

# ============================================================================
# DATABASE CONNECTIONS
# ============================================================================

# Primary Data Warehouse (PostgreSQL)
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sales_dw
DB_USER=your_username
DB_PASSWORD=your_password
DB_SCHEMA=public

# SQL Server (if applicable)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=sales_db
MSSQL_USER=your_username
MSSQL_PASSWORD=your_password

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Application Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here

# Debug Mode (set to False in production)
DEBUG=True

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log File Path
LOG_FILE_PATH=./logs/lvl_codes.log

# ============================================================================
# FORECASTING MODELS CONFIGURATION
# ============================================================================

# Model Training Settings
MODEL_TRAINING_ENABLED=True
MODEL_RETRAIN_FREQUENCY_DAYS=30
MODEL_VALIDATION_SPLIT=0.2
MODEL_TEST_SPLIT=0.1

# Model Storage Path
MODEL_STORAGE_PATH=./models/saved_models/

# MLflow Tracking (optional)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=2026_sales_targets

# ============================================================================
# TARGET SETTINGS
# ============================================================================

# Growth Target Configuration
TARGET_MINIMUM_NET_GROWTH=0.16      # 16% minimum net growth
TARGET_BASE_YEAR=2025               # Base year for growth calculation
TARGET_FORECAST_YEAR=2026           # Year to forecast

# Adjustment Triggers
VARIANCE_TRIGGER_THRESHOLD=0.10     # ±10% variance triggers review
ROLLING_FORECAST_WINDOW_MONTHS=12   # Rolling forecast window

# Scenario Planning
SCENARIO_BEST_CASE_GROWTH=0.22      # 22% best case
SCENARIO_BASE_CASE_GROWTH=0.16      # 16% base case
SCENARIO_WORST_CASE_GROWTH=0.10     # 10% worst case

# ============================================================================
# INVENTORY & STOCKOUT SETTINGS
# ============================================================================

# Stock Holding Configuration
STOCK_REORDER_POINT_DAYS=30         # Days of stock for reorder point
STOCK_SAFETY_BUFFER_PERCENT=0.20    # 20% safety stock buffer
STOCKOUT_RISK_THRESHOLD=0.15        # 15% stockout probability threshold

# Lead Times (days)
SUPPLIER_LEAD_TIME_DAYS=14
DISTRIBUTION_LEAD_TIME_DAYS=7

# ============================================================================
# DASHBOARD SETTINGS
# ============================================================================

# Dash Application
DASH_HOST=0.0.0.0
DASH_PORT=8050
DASH_DEBUG=True

# Refresh Intervals (seconds)
DASHBOARD_REFRESH_INTERVAL=300      # 5 minutes
KPI_REFRESH_INTERVAL=60             # 1 minute

# ============================================================================
# REPORTING & ALERTS
# ============================================================================

# Email Configuration (for alerts)
EMAIL_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_ADDRESS=alerts@lvl-codes.com

# Alert Recipients (comma-separated)
ALERT_RECIPIENTS=manager1@example.com,manager2@example.com

# Report Generation
REPORT_OUTPUT_PATH=./reports/
REPORT_GENERATION_HOUR=8            # Hour of day (24-hour format)

# ============================================================================
# REDIS (for caching and task queue)
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Cache TTL (seconds)
CACHE_TTL_SHORT=300                 # 5 minutes
CACHE_TTL_MEDIUM=3600               # 1 hour
CACHE_TTL_LONG=86400                # 24 hours

# ============================================================================
# CELERY (task queue)
# ============================================================================

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json

# ============================================================================
# API SETTINGS
# ============================================================================

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=True

# API Rate Limiting
API_RATE_LIMIT=100                  # Requests per minute
API_RATE_LIMIT_PERIOD=60            # Seconds

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8050

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# Sentry (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Weather API (for external factors)
WEATHER_API_KEY=
WEATHER_API_URL=https://api.weatherapi.com/v1

# Economic Indicators API
ECONOMIC_API_KEY=
ECONOMIC_API_URL=

# ============================================================================
# DATA QUALITY
# ============================================================================

# Great Expectations
GE_ENABLED=True
GE_CHECKPOINT_PATH=./great_expectations/checkpoints/
GE_VALIDATION_RESULTS_PATH=./great_expectations/uncommitted/validations/

# Data Quality Thresholds
DQ_MIN_COMPLETENESS=0.95            # 95% data completeness required
DQ_MAX_OUTLIER_PERCENT=0.05         # Max 5% outliers allowed

# ============================================================================
# PERFORMANCE & OPTIMIZATION
# ============================================================================

# Parallel Processing
N_JOBS=-1                           # -1 uses all CPU cores
PARALLEL_BACKEND=loky               # Options: loky, threading, multiprocessing

# Memory Management
MAX_MEMORY_GB=8                     # Maximum memory usage
CHUNK_SIZE=10000                    # Rows per chunk for large datasets

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/Disable Features
FEATURE_ML_MODELS=True
FEATURE_PROPHET=True
FEATURE_SARIMA=True
FEATURE_OPTIMIZATION=True
FEATURE_SCENARIO_PLANNING=True
FEATURE_STOCKOUT_PREDICTION=True
FEATURE_AUTOMATED_REPORTS=True
FEATURE_EMAIL_ALERTS=False

# ============================================================================
# TESTING
# ============================================================================

# Test Database
TEST_DB_NAME=sales_dw_test
TEST_DB_HOST=localhost
TEST_DB_PORT=5432

# Test Data Generation
TEST_DATA_SEED=42
TEST_DATA_ROWS=10000

# ============================================================================
# BACKUP & RECOVERY
# ============================================================================

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_PATH=./backups/
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_HOUR=2              # 2 AM daily

# ============================================================================
# MONITORING & METRICS
# ============================================================================

# Prometheus (optional)
PROMETHEUS_PORT=9090
METRICS_ENABLED=False

# Health Check
HEALTH_CHECK_INTERVAL=60            # Seconds

# ============================================================================
# MISCELLANEOUS
# ============================================================================

# Timezone
TIMEZONE=UTC

# Date Format
DATE_FORMAT=%Y-%m-%d
DATETIME_FORMAT=%Y-%m-%d %H:%M:%S

# Currency
CURRENCY=USD
CURRENCY_SYMBOL=$

# Locale
LOCALE=en_US

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
